# Public API origin (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional: gate the public demo Next.js routes behind a shared password
# DEMO_PASSWORD=your-pilot-password

# Optional: if the API also has DEMO_PASSWORD set, send the same value
# NEXT_PUBLIC_API_DEMO_PASSWORD=your-pilot-password

# Canonical site URL (Open Graph / metadata)
# NEXT_PUBLIC_SITE_URL=https://totalrewardsaccelerator.com

# --- SaaS (Supabase Auth) — required for /app, /signup, account login ---
# Project Settings → API
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Ask TRA (public chat assistant) ---
# AI Gateway key — or run on Vercel with OIDC instead of a static key.
# AI_GATEWAY_API_KEY=
# Model + budget overrides (defaults: openai/gpt-4o-mini, alert $20, cap $25)
# ASK_TRA_MODEL=openai/gpt-4o-mini
# ASK_TRA_BUDGET_ALERT_USD=20
# ASK_TRA_BUDGET_CAP_USD=25
# Required for the durable budget counter + queued handoffs in production
# (migration api/app/db/migrations/006_ask_tra.sql). Without it, counters are
# in-memory only and reset on cold start.
# SUPABASE_SERVICE_ROLE_KEY=
# Handoff email delivery ("Talk to Mike" → Rio's inbox). Without these, form
# submissions are stored in the ask_tra_handoffs table instead of emailed.
# RESEND_API_KEY=
# ASK_TRA_FROM_EMAIL=Ask TRA <ask@yourdomain>
# ASK_TRA_CONTACT_EMAIL=heyrio@mail.grokbot.com
