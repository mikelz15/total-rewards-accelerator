{
  "expo": {
    "name": "Total Rewards Accelerator",
    "slug": "total-rewards-accelerator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tra",
    "userInterfaceStyle": "automatic",
    "description": "Comp Engineering toolkit: Cleaner, Equity + Merit, Candidate Tracker, and Closer. Stop crunching rows. Start designing strategy.",
    "primaryColor": "#0f766e",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikez.totalrewardsaccelerator",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSPhotoLibraryUsageDescription": "Optional: attach CSV/TSV exports for Market Data Cleaner.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.mikez.totalrewardsaccelerator",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f8fafc"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0f766e",
          "sounds": []
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://tra-api-starter.onrender.com",
      "privacyPolicyUrl": "https://totalrewardsaccelerator.com/privacy",
      "router": {},
      "eas": {
        "projectId": "3bd2110d-f225-4850-be64-d688d36caf0e"
      }
    },
    "owner": "mikelz15"
  }
}
