# Optional demo password — requires X-Demo-Password header on public demo API routes
# DEMO_PASSWORD=your-pilot-password

# CORS: * or comma-separated web origins
# CORS_ORIGINS=https://totalrewardsaccelerator.com,https://www.totalrewardsaccelerator.com,http://localhost:3000
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- SaaS (Supabase) — leave unset to keep demo-only API ---
# Project Settings → Database → Connection string (URI), use Session mode or Transaction pooler
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Project Settings → API → JWT Secret (not the anon key)
# SUPABASE_JWT_SECRET=your-jwt-secret

# Optional: Project URL (for docs / future service-role use)
# SUPABASE_URL=https://xxxx.supabase.co
